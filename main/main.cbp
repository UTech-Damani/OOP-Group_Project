			<Option virtualFolder="data/" />
		</Unit>
		<Unit filename="include/Spectator.h" />
		<Unit filename="main.cpp" />
		<Unit filename="src/Fixture.h" />
		<Unit filename="src/FootballLeague.h" />
		<Unit filename="src/MatchResults.h" />
		<Unit filename="src/Stadium.h" />
		<Unit filename="src/StadiumShop.h" />
		<Unit filename="universal/Date.h" />
		<Unit filename="universal/Time.h" />
		<Extensions>
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
